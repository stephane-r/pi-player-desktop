{
  "name": "piplayer-desktop",
  "version": "1.0.0",
  "description": "Client IPTV de bureau (Electron + mpv en fenêtre séparée)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-reloader": "^2.0.0"
  },
  "build": {
    "appId": "dev.piplayer.desktop",
    "productName": "PiPlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "mpv-ipc.js",
      "renderer/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "identity": null
    },
    "win": {
      "target": "nsis"
    }
  }
}
